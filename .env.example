# ============================================================================
# AI Task Manager - Environment Configuration Example
# ============================================================================
# Copy this file to `.env` in the root directory (or `server/.env`) and fill
# in your actual values. NEVER commit real `.env` files to version control.

# Server Configuration
PORT=3000
NODE_ENV=development

# MongoDB Connection URI (MongoDB Atlas or local MongoDB instance)
# Example: mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/ai-task-manager?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/ai-task-manager

# Groq AI Configuration
# Obtain an API key from https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
# Recommended active Groq production models: llama-3.3-70b-versatile, llama-3.1-8b-instant, openai/gpt-oss-20b
GROQ_MODEL=llama-3.3-70b-versatile

# CORS Configuration (Frontend Origin)
CLIENT_ORIGIN=http://localhost:5173

# Optional Frontend API Base URL (used by Vite in client/.env if needed)
# Leave empty in local development to use the Vite /api proxy, or set to http://localhost:3000
VITE_API_URL=
