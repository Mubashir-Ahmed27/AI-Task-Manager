{
  "name": "ai-task-manager-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Backend API for Full-Stack AI Task Manager",
  "main": "src/server.js",
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "test": "node --test tests/unit/task-validation.test.js tests/unit/ai-validation.test.js tests/integration/api.test.js tests/integration/ai-api.test.js",
    "test:watch": "node --test --watch tests/unit/task-validation.test.js tests/unit/ai-validation.test.js tests/integration/api.test.js tests/integration/ai-api.test.js",
    "lint": "node --check src/server.js && node --check src/app.js"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "groq-sdk": "^0.15.0",
    "mongoose": "^8.10.1"
  },
  "engines": {
    "node": "22.x"
  },
  "devDependencies": {
    "mongodb-memory-server": "^10.1.4",
    "supertest": "^7.0.0"
  }
}
