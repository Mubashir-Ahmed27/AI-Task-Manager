# Copy to server/.env (or the repository root .env) and fill in real values.
# Never commit the real .env file.

PORT=3000
NODE_ENV=development

# MongoDB connection string (Atlas or local)
MONGODB_URI=mongodb://127.0.0.1:27017/ai-task-manager

# Groq AI planner (server-side only — never expose in the browser)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Allowed browser origin for CORS (comma-separated list supported)
CLIENT_ORIGIN=http://localhost:5173

# Optional: AI request timeout in milliseconds (default 15000)
AI_TIMEOUT_MS=15000
