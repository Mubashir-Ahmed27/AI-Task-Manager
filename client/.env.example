# Optional. Copy to client/.env only if you need to override the API base URL.
#
# Leave this EMPTY for local development: the browser calls /api/... and Vite's
# dev server proxies those requests to http://localhost:3000 (see vite.config.js).
#
# In production set it to the deployed backend origin, e.g.
# VITE_API_URL=https://ai-task-manager-api.onrender.com
#
# SECURITY: every VITE_ variable is embedded in the public JS bundle.
# Never put secrets (GROQ_API_KEY etc.) in this file.
VITE_API_URL=
