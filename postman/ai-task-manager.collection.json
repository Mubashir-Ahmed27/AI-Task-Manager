{
  "info": {
    "_postman_id": "b7c1f0e2-5a4d-4f8e-9f2b-aitaskmanager",
    "name": "AI Task Manager API",
    "description": "Collection for the Full-Stack AI Task Manager (Express + MongoDB + Groq).\n\nVariables:\n- baseUrl (default http://localhost:3000)\n- taskId is captured automatically by the Create Task request test script.\n\nSuggested run order: Health -> Create Task -> List Tasks -> Get Task -> Update Task -> Delete Task -> AI Planner -> Error cases.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000",
      "type": "string"
    },
    {
      "key": "taskId",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "GET /api/health",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "health"
              ]
            },
            "description": "Returns service status. Must never expose credentials."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Reports ok status', () => pm.expect(pm.response.json().status).to.eql('ok'));",
                  "pm.test('Does not leak secrets', () => {",
                  "  const body = pm.response.text();",
                  "  pm.expect(body).to.not.include('GROQ_API_KEY');",
                  "  pm.expect(body).to.not.include('mongodb');",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Tasks",
      "item": [
        {
          "name": "Create Task",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Prepare sprint demo\",\n  \"description\": \"Walk through the AI planner and dashboard\",\n  \"status\": \"pending\",\n  \"dueDate\": \"2026-12-01T00:00:00.000Z\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/tasks",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "tasks"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 201', () => pm.response.to.have.status(201));",
                  "const json = pm.response.json();",
                  "pm.test('Response has success + task', () => {",
                  "  pm.expect(json.success).to.be.true;",
                  "  pm.expect(json.task).to.have.property('_id');",
                  "});",
                  "pm.test('Defaults to pending status', () => pm.expect(json.task.status).to.eql('pending'));",
                  "pm.collectionVariables.set('taskId', json.task._id);"
                ]
              }
            }
          ]
        },
        {
          "name": "List Tasks",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/tasks",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "tasks"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "pm.test('Returns a task array with count', () => {",
                  "  pm.expect(json.success).to.be.true;",
                  "  pm.expect(json.tasks).to.be.an('array');",
                  "  pm.expect(json.count).to.eql(json.tasks.length);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Get Task by ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/tasks/{{taskId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "tasks",
                "{{taskId}}"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Returns the requested task', () => {",
                  "  const json = pm.response.json();",
                  "  pm.expect(json.task._id).to.eql(pm.collectionVariables.get('taskId'));",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Update Task",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Prepare sprint demo (final)\",\n  \"status\": \"completed\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/tasks/{{taskId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "tasks",
                "{{taskId}}"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "pm.test('Applies the update', () => {",
                  "  pm.expect(json.task.status).to.eql('completed');",
                  "  pm.expect(json.task.title).to.include('final');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Delete Task",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/tasks/{{taskId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "tasks",
                "{{taskId}}"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Confirms deletion', () => pm.expect(pm.response.json().success).to.be.true);"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "AI Planner",
      "item": [
        {
          "name": "POST /api/ai/plan-task (Generate Plan)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"description\": \"I need to build a portfolio website within three days.\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/ai/plan-task",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "ai",
                "plan-task"
              ]
            },
            "description": "Requires GROQ_API_KEY on the server. 200 = plan generated, 429 = provider rate limit, 503 = AI not configured, 502/504 = provider failure/timeout."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const status = pm.response.status ? pm.response.code : 0;",
                  "pm.test('Status is 200, 429, 503 or 502/504', () => pm.expect([200, 429, 502, 503, 504]).to.include(status));",
                  "if (status === 200) {",
                  "  const plan = pm.response.json().plan;",
                  "  pm.test('Plan contract is valid', () => {",
                  "    pm.expect(plan.summary).to.be.a('string').and.not.empty;",
                  "    pm.expect(['low','medium','high']).to.include(plan.priority);",
                  "    pm.expect(plan.estimatedHours).to.be.above(0);",
                  "    pm.expect(plan.steps).to.be.an('array');",
                  "    pm.expect(plan.steps.length).to.be.within(3, 7);",
                  "  });",
                  "} else {",
                  "  pm.test('Failure returns a safe message', () => {",
                  "    const body = pm.response.json();",
                  "    pm.expect(body.success).to.be.false;",
                  "    pm.expect(body.message).to.be.a('string').and.not.empty;",
                  "  });",
                  "}"
                ]
              }
            }
          ]
        }
      ]
    },
